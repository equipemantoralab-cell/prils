# Token pessoal do ClickUp (Settings → Apps → API Token). Precisa ter acesso ao espaço dos Reports.
CLICKUP_TOKEN=pk_xxx

# Token da Meta (Instagram + Meta Ads). Ideal: token de Usuário do Sistema do Business Manager, que não expira.
# Permissões: ads_read, instagram_basic, instagram_manage_insights, pages_read_engagement, business_management.
META_TOKEN=EAAxxx
